PORT=25566

# Configure this feature only on a protected backend.
MATCH_INGEST_TOKEN=replace-with-a-long-random-secret
REDIS_URL=redis://127.0.0.1:6379
MATCH_RESULTS_QUEUE=redis

# Path to the downloaded Google Service Account JSON. Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\boardgame-sheets-service-account.json
MATCH_SHEETS_SPREADSHEET_ID=1AQsnAoWM2h1l1KnF0YTUzgFSlW-Tb8HpIzFUxRJlpIY
MATCH_SHEETS_RANGE=Matches!A:E
MATCH_SHEETS_BATCH_SIZE=500
MATCH_SHEETS_FLUSH_INTERVAL_MS=3000
MATCH_SHEETS_MIN_APPEND_INTERVAL_MS=1200
MATCH_SHEETS_TOURNAMENT_SYNC_MS=5000
MATCH_RESULTS_MAX_QUEUE=100000

# Used by the bounded local load-test helper. External hosts require explicit opt-in.
MATCH_RESULTS_TEST_TOKEN=
MATCH_RESULTS_TEST_URL=http://127.0.0.1:25566/api/match-results
MATCH_RESULTS_TEST_COUNT=1000
MATCH_RESULTS_TEST_CONCURRENCY=25
